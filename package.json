    "c7-mcp-server": "^1.0.1",
    "globals": "^17.7.0",
    "knip": "^6.27.0",
    "netscape-cookies-parser": "^1.0.2",
    "node-html-parser": "^9.0.0",
    "prisma": "7.9.0",
    "rimraf": "^6.1.3",
    "satori": "^0.28.2",
    "sharp": "^0.35.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-intlayer": "~8.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.113.0"
  }
}
