{
  "name": "biccame-musume",
  "version": "0.31.1",
  "type": "module",
  "description": "ビックカメラの店舗擬人化キャラクター「ビッカメ娘」を応援する非公式ファンサイト",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "patchedDependencies": {
    "vite-intlayer@8.5.2": "patches/vite-intlayer@8.5.2.patch"
  },
  "scripts": {
    "//routes:generate": "src/app/routeTree.gen.ts は gitignore 済み。predev / prebuild で必ず生成する。vite dev/build 中も plugin が更新するが、tsc -b が先に走るビルドや fresh clone のために事前生成が必要。",
    "routes:generate": "bun run scripts/generate-route-tree.ts",
    "predev": "bun run routes:generate",
    "dev": "vite --host --port 15175",
    "build": "tsc -b && vite build --mode ${CLOUDFLARE_ENV:-production}",
    "build:production": "CLOUDFLARE_ENV=production bun run build",
    "build:staging": "CLOUDFLARE_ENV=staging bun run build",
    "migrate": "wrangler d1 execute biccame-musume-events --env=staging --local --file=./prisma/migrations/init/migration.sql",
    "generate": "prisma generate",
    "prebuild": "bun run routes:generate && rimraf dist && bun run images:download && bun run og:generate",
    "predeploy": "bun run routes:generate && tsc -b && vite build --mode ${CLOUDFLARE_ENV:-production}",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-production}",
    "deploy:production": "CLOUDFLARE_ENV=production bun run predeploy && CLOUDFLARE_ENV=production wrangler deploy --keep-vars --env=production",
    "deploy:staging": "CLOUDFLARE_ENV=staging bun run predeploy && CLOUDFLARE_ENV=staging wrangler deploy --keep-vars --env=staging",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "knip": "knip",
    "anniversary:seed": "bun run scripts/seed-anniversary-11.ts",
    "badges:seed": "bun run scripts/seed-badges.ts",
    "badges:backfill": "bun run scripts/backfill-badges.ts",
    "images:download": "bun run scripts/download-character-images.ts",
    "og:generate": "bun run scripts/generate-og-images.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "~1.46.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@elithrar/workers-hono-rate-limit": "^0.5.1",
    "@fontsource/m-plus-1-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@hono/firebase-auth": "^1.4.2",
    "@hono/zod-openapi": "^1.5.1",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-d1": "7.9.0",
    "@prisma/client": "7.9.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@zodios/core": "^10.9.6",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.16.0",
    "firebase-auth-cloudflare-workers": "^2.0.6",
    "hono": "^4.12.31",
    "intlayer": "~8.8.0",
    "jaconv": "^1.1.2",
    "jose": "^6.2.4",
    "jotai": "^2.20.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/bun": "^1.3.14",
    "@types/google.maps": "^3.65.2",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "c7-mcp-server": "^1.0.1",
    "globals": "^17.7.0",
    "knip": "^6.27.0",
    "netscape-cookies-parser": "^1.0.2",
    "node-html-parser": "^9.0.0",
    "prisma": "7.9.0",
    "rimraf": "^6.1.3",
    "satori": "^0.28.2",
    "sharp": "^0.35.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-intlayer": "~8.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.113.0"
  }
}
