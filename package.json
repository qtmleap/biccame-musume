{
  "name": "biccame-musume",
  "version": "0.33.6",
  "type": "module",
  "description": "ビックカメラの店舗擬人化キャラクター「ビッカメ娘」を応援する非公式ファンサイト",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "patchedDependencies": {
    "vite-intlayer@8.5.2": "patches/vite-intlayer@8.5.2.patch"
  },
  "scripts": {
    "dev": "vite --host --port 15175",
    "//migrate": "スキーマ変更は migrate:new で SQL を生成し、migrate:apply:* で適用する。remote 系は wrangler に CLOUDFLARE_API_TOKEN が要るので `source .env &&` を前置すること。",
    "migrate": "bun run migrate:apply:local",
    "migrate:new": "bun run scripts/create-migration.ts",
    "migrate:apply:local": "wrangler d1 migrations apply biccame-musume-dev --local",
    "migrate:apply:staging": "wrangler d1 migrations apply biccame-musume-dev --env=staging --remote",
    "migrate:apply:production": "wrangler d1 migrations apply biccame-musume-prod --env=production --remote",
    "migrate:status:local": "wrangler d1 migrations list biccame-musume-dev --local",
    "migrate:status:staging": "wrangler d1 migrations list biccame-musume-dev --env=staging --remote",
    "migrate:status:production": "wrangler d1 migrations list biccame-musume-prod --env=production --remote",
    "migrate:diff:local": "prisma migrate diff --from-config-datasource --to-schema ./prisma/schema.prisma --config ./prisma/prisma.config.ts --script",
    "generate": "prisma generate",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-production}",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "knip": "knip"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "~1.46.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@elithrar/workers-hono-rate-limit": "^0.5.1",
    "@fontsource/m-plus-1-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@hono/firebase-auth": "^1.4.2",
    "@hono/zod-openapi": "^1.5.1",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-d1": "7.9.0",
    "@prisma/client": "7.9.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@zodios/core": "^10.9.6",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.16.0",
    "firebase-auth-cloudflare-workers": "^2.0.6",
    "hono": "^4.12.31",
    "intlayer": "~8.8.0",
    "jaconv": "^1.1.2",
    "jose": "^6.2.4",
    "jotai": "^2.20.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
