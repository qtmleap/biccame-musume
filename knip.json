{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@biomejs/biome",
    "@prisma/client",
    "cloudflare",
    "@tailwindcss/typography",
    "c7-mcp-server",
    "globals",
    "tailwindcss",
    "tailwindcss-animate",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".vscode/scripts/*.ts",
        "__tests__/**/*.test.ts",
        "e2e/**/*.spec.ts",
        "scripts/**/*.ts",
        ".storybook/tests/**/*.{ts,tsx}",
        ".storybook/catalogue/serve.ts",
        ".storybook/mocks/client.ts",
        ".storybook/mocks/firebase.ts",
        ".storybook/mocks/maps.tsx",
        ".storybook/mocks/pwa-cache.ts",
        ".storybook/mocks/vote-atom.ts"
      ],
      "project": [
        ".vscode/scripts/*.ts",
        "__tests__/**/*.ts",
        "scripts/**/*.ts",
        "prisma/**/*.prisma",
        ".storybook/**/*.{ts,tsx}"
      ]
    },
    "workers/bot": {
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "workers/app": {
      "entry": [
        "src/stories/**/*.stories.tsx",
        "src/lib/harfbuzz-workers.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
