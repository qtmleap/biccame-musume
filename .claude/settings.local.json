{
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(terraform apply *.staging.tfplan:*)",
      "Bash(terraform apply *staging*.tfplan:*)",
      "Bash(terraform apply tfplan.staging:*)",
      "Cd",
      "Edit",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "Monitor",
      "MultiEdit",
      "NotebookEdit",
      "Read",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__chrome-devtools__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__plugin_github_github__*",
      "mcp__prisma__*",
      "mcp__shadcn__*",
      "mcp__tailwindcss__*",
      "mcp__terraform__*",
      "mcp__zod__*"
    ],
    "deny": [
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git config --global:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(pnpx:*)",
      "Bash(rm -rf /:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform workspace delete:*)",
      "Bash(yarn:*)",
      "Edit(**/*.pem)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.secrets)",
      "Edit(**/.secrets/**)",
      "Edit(**/private.key)",
      "Read(**/*.pem)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.secrets)",
      "Read(**/.secrets/**)",
      "Read(**/private.key)"
    ],
    "defaultMode": "bypassPermissions",
    "bypassPermissionsMode": "allow"
  },
  "model": "claude-opus-4-7",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"/home/vscode/.claude/plugins/cache/qtmleap-plugins/devflow/0.4.4/hooks/boot-check.sh\"",
            "timeout": 10,
            "statusMessage": "devflow: git identity check"
          }
        ]
      }
    ]
  }
}
