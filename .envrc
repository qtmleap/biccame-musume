dotenv_if_exists .env

# .npmrc が @qtmleap スコープを GitHub Packages から取得する際の認証に GITHUB_TOKEN を参照する。
# .env や親シェルで未設定のときだけ gh のトークンを補う（gh が無い・未ログインなら何もしない）。
if [ -z "${GITHUB_TOKEN:-}" ] && has gh; then
  _gh_token="$(gh auth token --hostname github.com 2>/dev/null || true)"
  if [ -n "${_gh_token}" ]; then
    export GITHUB_TOKEN="${_gh_token}"
  fi
  unset _gh_token
fi
